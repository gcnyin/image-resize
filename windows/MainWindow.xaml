<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ImageResize.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ImageResize.Controls">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏：内容延伸进标题栏后系统不再绘制标题，这里自绘；整条作为拖动区（不放交互控件） -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="32" Padding="16,0,16,0" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xEB9F;" FontSize="14"
                          Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="图片工具" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- 顶栏：打开 / 保存 -->
        <Grid Grid.Row="1" Padding="16,10,16,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="BtnPick" Content="选择图片" Click="BtnPick_Click"/>
                <Button x:Name="BtnSave" Content="保存" Style="{ThemeResource AccentButtonStyle}"
                        Click="BtnSave_Click" IsEnabled="False"/>
            </StackPanel>
        </Grid>

        <!-- 画布：图片 + 裁剪覆盖层 + 空态提示 + 忙碌指示 + 成功小字（覆盖层） -->
        <Grid x:Name="CanvasHost" Grid.Row="2" Margin="16,8,16,8"
              Background="Transparent"
              AllowDrop="True"
              DragOver="CanvasHost_DragOver"
              Drop="CanvasHost_Drop"
              SizeChanged="CanvasHost_SizeChanged">
            <Image x:Name="ImageCtrl" Stretch="Uniform"/>
            <controls:CropOverlay x:Name="CropOverlay" Visibility="Collapsed"/>
            <TextBlock x:Name="EmptyHint" Text="请选择一张图片开始"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <ProgressRing x:Name="BusyRing" Width="48" Height="48"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          IsActive="False" Visibility="Collapsed"/>
            <!-- 成功反馈：一行小字覆盖层，不参与布局，避免顶起底部面板 -->
            <Border x:Name="SuccessToast"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,10" Padding="10,4" CornerRadius="8"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    IsHitTestVisible="False" Visibility="Collapsed">
                <TextBlock x:Name="ToastText" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Border>
        </Grid>

        <!-- 底部面板：反馈 / 模式与操作 + 右侧信息 -->
        <Border Grid.Row="3" Padding="16,10,16,12"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel Spacing="8">
                <InfoBar x:Name="Feedback" IsOpen="False"/>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                        <RadioButton x:Name="ModeCrop" Content="剪裁" GroupName="Mode" MinWidth="76"
                                     Checked="Mode_Checked"/>
                        <RadioButton x:Name="ModeResize" Content="缩放" GroupName="Mode" MinWidth="76"
                                     Checked="Mode_Checked"/>
                        <Border Width="1" Height="30" Margin="4,0"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                        <!-- 剪裁子面板 -->
                        <StackPanel x:Name="CropControls" Orientation="Horizontal" Spacing="8"
                                    Visibility="Collapsed">
                            <Button x:Name="BtnFull" Content="全图" Click="BtnFull_Click" IsEnabled="False"/>
                            <Button x:Name="BtnApplyCrop" Content="应用剪裁" Style="{ThemeResource AccentButtonStyle}"
                                    Click="BtnApplyCrop_Click" IsEnabled="False"/>
                        </StackPanel>

                        <!-- 缩放子面板 -->
                        <StackPanel x:Name="ResizeControls" Orientation="Horizontal" Spacing="8"
                                    Visibility="Collapsed" VerticalAlignment="Center">
                            <Slider x:Name="PercentSlider" Width="220" Minimum="10" Maximum="100"
                                    SnapsTo="StepValues" StepFrequency="1" Value="50"
                                    ValueChanged="PercentSlider_ValueChanged"
                                    IsEnabled="False"/>
                            <TextBlock x:Name="PercentText" Text="50%" FontSize="16" MinWidth="46"
                                       TextAlignment="Center" VerticalAlignment="Center"/>
                            <Button x:Name="Btn25" Content="25%" Tag="25" Click="BtnQuick_Click" IsEnabled="False"/>
                            <Button x:Name="Btn50" Content="50%" Tag="50" Click="BtnQuick_Click" IsEnabled="False"/>
                            <Button x:Name="Btn75" Content="75%" Tag="75" Click="BtnQuick_Click" IsEnabled="False"/>
                            <Button x:Name="BtnApplyResize" Content="应用缩放" Style="{ThemeResource AccentButtonStyle}"
                                    Click="BtnApplyResize_Click" IsEnabled="False"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 信息行：与操作同一行，靠右；空间不够时省略号截断 -->
                    <TextBlock x:Name="InfoText" Grid.Column="1" FontSize="12"
                               HorizontalAlignment="Right" TextAlignment="Right" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="请选择一张图片开始"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
